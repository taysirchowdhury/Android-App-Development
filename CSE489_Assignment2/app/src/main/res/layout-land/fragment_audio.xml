<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/audio_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="200dp" android:padding="12dp">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:padding="16dp" android:background="@drawable/audio_player_card"
                app:layout_constraintWidth_max="740dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <FrameLayout android:layout_width="110dp" android:layout_height="110dp"
                    android:background="@drawable/audio_art_background">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="center" android:src="@drawable/ic_music"
                        app:tint="@color/white"
                        android:contentDescription="@string/audio_icon_description" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="18dp"
                    android:orientation="vertical">

                    <TextView android:id="@+id/audio_error" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/audio_error_short"
                        android:textColor="@color/audio_error" android:visibility="gone" />
                    <SeekBar android:id="@+id/audio_seek" android:layout_width="match_parent"
                        android:layout_height="34dp" android:layout_marginTop="5dp"
                        android:progressTint="@color/audio_accent"
                        android:thumbTint="@color/audio_accent" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/audio_elapsed" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/audio_time_zero" android:textSize="12sp"
                            android:textColor="@color/audio_secondary" />
                        <TextView android:id="@+id/audio_duration" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="@string/audio_time_zero"
                            android:textSize="12sp" android:textColor="@color/audio_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <ImageButton android:id="@+id/audio_toggle" android:layout_width="52dp"
                    android:layout_height="52dp" android:layout_marginStart="14dp"
                    android:padding="13dp" android:background="@drawable/audio_play_background"
                    android:src="@drawable/ic_play" app:tint="@color/white"
                    android:contentDescription="@string/play" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
